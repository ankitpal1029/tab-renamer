{
  "manifest_version": 3,
  "name": "Tab Renamer",
  "version": "1.1",
  "description": "Right-click on tabs to rename them with custom titles",
  "minimum_chrome_version": "111",
  "permissions": ["tabs", "contextMenus", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["slack-call-tab.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Renamer"
  },
  "icons": {
    "16": "icons/icon16.jpg",
    "48": "icons/icon48.jpg",
    "128": "icons/icon128.jpg"
  }
}
